{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/bookings/{**catch-all}"
        }
      },
      "payment-methods-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "service-payments-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/service-payments/{**catch-all}"
        }
      },
      "iam-route": {
        "ClusterId": "iam-cluster",
        "Match": {
          "Path": "/api/iam/{**catch-all}"
        }
      },
      "profile-route": {
        "ClusterId": "profile-cluster",
        "Match": {
          "Path": "/api/profiles/{**catch-all}"
        }
      },
      "workers-route": {
        "ClusterId": "profile-cluster",
        "Match": {
          "Path": "/api/workers/{**catch-all}"
        }
      },
      "reviews-route": {
        "ClusterId": "reviews-cluster",
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        }
      },
      "notifications-route": {
        "ClusterId": "communication-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "booking-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://booking-service:8080"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://payment-service:8000"
          }
        }
      },
      "iam-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://iam-service:8080"
          }
        }
      },
      "profile-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://profile-service:8080"
          }
        }
      },
      "reviews-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://reviews-service:8080"
          }
        }
      },
      "communication-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://communication-service:8080"
          }
        }
      }
    }
  }
}
